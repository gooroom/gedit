Index: gedit-48.1-clean/gedit/gedit-tab.c
===================================================================
--- gedit-48.1-clean.orig/gedit/gedit-tab.c
+++ gedit-48.1-clean/gedit/gedit-tab.c
@@ -2153,6 +2153,29 @@ _gedit_tab_revert (GeditTab *tab)
 }

 static void
+show_error_dialog (GeditTab        *tab,
+                   const gchar     *message,
+                   GError          *error)
+{
+	GtkWidget *dialog;
+
+	dialog = gtk_message_dialog_new (GTK_WINDOW (gtk_widget_get_toplevel (GTK_WIDGET (tab))),
+		                         GTK_DIALOG_MODAL | GTK_DIALOG_DESTROY_WITH_PARENT | GTK_DIALOG_USE_HEADER_BAR,
+					 GTK_MESSAGE_ERROR,
+					 GTK_BUTTONS_CLOSE,
+					 "%s", message);
+
+	if (error == NULL) {
+		gtk_window_set_title (GTK_WINDOW (dialog), _("Error"));
+		gtk_message_dialog_format_secondary_text (GTK_MESSAGE_DIALOG (dialog),
+				    "%s", _("Can not set print range over the maximum page."));
+	}
+
+	g_signal_connect (dialog, "response", G_CALLBACK (gtk_widget_destroy), NULL);
+	gtk_window_present (GTK_WINDOW (dialog));
+}
+
+static void
 close_printing (GeditTab *tab)
 {
 	if (tab->print_preview != NULL)
@@ -2697,6 +2720,12 @@ done_printing_cb (GeditPrintJob       *j
 		store_print_settings (tab, job);
 	}

+	if (gedit_print_job_get_page_over(job)) {
+		show_error_dialog (tab,
+				_("Failed to print"),
+				NULL);
+	}
+
 	/* TODO Show the error in an info bar. */
 	if (error != NULL)
 	{
