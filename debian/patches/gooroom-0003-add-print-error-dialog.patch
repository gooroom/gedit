Description: Add error dialog for invalid print range
 Show error dialog when print range exceeds maximum page
Author: Gooroom <gooroom@gooroom.kr>
Bug-Gooroom: https://wiki.gooroom.kr/

Index: gedit-48.1-clean/gedit/gedit-print-job.h
===================================================================
--- gedit-48.1-clean.orig/gedit/gedit-print-job.h
+++ gedit-48.1-clean/gedit/gedit-print-job.h
@@ -64,6 +64,8 @@ GtkPrintSettings	*gedit_print_job_get_pr

 GtkPageSetup		*gedit_print_job_get_page_setup		(GeditPrintJob *job);

+gboolean		 gedit_print_job_get_page_over		(GeditPrintJob *job);
+
 G_END_DECLS

 #endif /* GEDIT_PRINT_JOB_H */
Index: gedit-48.1-clean/gedit/gedit-print-job.c
===================================================================
--- gedit-48.1-clean.orig/gedit/gedit-print-job.c
+++ gedit-48.1-clean/gedit/gedit-print-job.c
@@ -55,6 +55,7 @@ struct _GeditPrintJob
 	GtkFontButton *numbers_fontbutton;

 	guint is_preview : 1;
+	gboolean page_over;
 };

 enum
@@ -221,6 +222,7 @@ gedit_print_job_init (GeditPrintJob *job
 	job->gsettings = g_settings_new ("org.gnome.gedit.preferences.print");

 	job->status_string = g_strdup (_("Preparing…"));
+	job->page_over = FALSE;
 }

 static void
@@ -579,9 +581,22 @@ paginate_cb (GtkPrintOperation *operatio

 	if (finished)
 	{
-		gint n_pages;
+		GtkPrintSettings *settings = NULL;
+		GtkPageRange     *ranges = NULL;
+		gint              n_pages, i, num_ranges;

 		n_pages = gtk_source_print_compositor_get_n_pages (job->compositor);
+		settings = gedit_print_job_get_print_settings (job);
+		ranges = gtk_print_settings_get_page_ranges (settings, &num_ranges);
+		if (ranges) {
+			for (i = 0; i < num_ranges; i++)
+				if (ranges[i].start >= n_pages) {
+					job->page_over = TRUE;
+					break;
+				}
+			g_free (ranges);
+		}
+
 		gtk_print_operation_set_n_pages (job->operation, n_pages);
 	}

@@ -816,4 +831,12 @@ gedit_print_job_get_page_setup (GeditPri
 	return gtk_print_operation_get_default_page_setup (job->operation);
 }

+gboolean
+gedit_print_job_get_page_over (GeditPrintJob *job)
+{
+	g_return_val_if_fail (GEDIT_IS_PRINT_JOB (job), FALSE);
+
+	return job->page_over;
+}
+
